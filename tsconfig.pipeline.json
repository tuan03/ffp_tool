{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/shopify-pipeline-worker.ts",
    "scripts/seo-worker-cutover.ts",
    "scripts/export-seo-worker-contracts.ts",
    "gateway",
    "src/modules/customization-normalizer",
    "src/modules/shopify-sync",
    "src/modules/module-api"
  ]
}
