{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/shopify-pipeline-worker.ts",
    "gateway",
    "src/modules/customization-normalizer",
    "src/modules/shopify-sync",
    "src/modules/module-api"
  ]
}
