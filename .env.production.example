# ========================================================
# FFP Tool Production Environment Configuration Template
# Copy this content into GitHub Secret 'ENV_FILE' or VPS .env
# ========================================================

NODE_ENV=production
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3001
STATIC_DIR=/app/dist

# --- Security Credentials (Generate random values, DO NOT leave blank) ---
# Master admin token used internally by worker, reverse proxy, and admin APIs
GATEWAY_AUTH_TOKEN=your-random-32-char-gateway-auth-token

# Browser login for the internal FFP Tool UI. Use a unique strong password.
FFP_OPERATOR_USERNAME=admin
FFP_OPERATOR_PASSWORD=replace-with-a-strong-unique-password

# Store-specific keys dedicated to ChatGPT OpenAI Actions
GPT_SEO_ACTION_KEYS_JSON={"capozen":"replace-with-random-key","jeminise":"replace-with-another-random-key"}
GPT_SEO_STORE_ID=capozen

# Public HTTPS URL of this deployment
GPT_SEO_PUBLIC_URL=https://ffp.b6-team.site

# --- Database & Persistent Storage Paths (inside container volumes) ---
POSTGRES_DB=ffp_tool
POSTGRES_USER=ffp_tool
POSTGRES_PASSWORD=change_me
AUTO_SEO_DATABASE_URL=postgresql://ffp_tool:change_me@database:5432/ffp_tool
GPT_SEO_DB_PATH=/app/.local-data/custom-gpt-seo.sqlite3
# Legacy read-only Auto SEO migration source; not the production backup or review store.
AUTO_SEO_DB_PATH=/app/.local-data/auto-seo.sqlite3
SEO_CONFLICT_CORPUS_PATH=/app/.runtime/seo-conflict-corpus.json

# --- Shopify Store Credentials ---
GATEWAY_STORE_ID=capozen
GATEWAY_SHOP_DOMAIN=capozen.myshopify.com
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
SHOPIFY_GATEWAY_URL=http://127.0.0.1:3001/api/shopify

# --- Pipeline Worker & Amazon Crawler (Optional) ---
# Set to true if you run the Amazon crawler coordinator and pipeline worker
START_PIPELINE_WORKER=false
SHOPIFY_PIPELINE_COORDINATOR_URL=http://127.0.0.1:8766
SHOPIFY_PIPELINE_WORKERS=4
AMAZON_COORDINATOR_JOB_RETENTION_MINUTES=60
# VITE_AMAZON_CRAWLER_RELEASE_API_URL=https://api.github.com/repos/tuan03/ffp_tool/releases/latest
