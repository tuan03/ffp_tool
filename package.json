{
  "name": "ffp-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Modular React, TypeScript, Vite, and Tailwind application.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:mock": "tsc --noEmit -p tsconfig.json && vite build --mode mock",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/modules/*/__tests__/*.test.ts gateway/__tests__/*.test.ts",
    "gateway:start": "tsx gateway/server.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  }
}
