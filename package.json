{
  "name": "ffp-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular React, TypeScript, Vite, and Tailwind application.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node --disable-warning=ExperimentalWarning ./node_modules/vite/bin/vite.js --configLoader runner --host 0.0.0.0",
    "dev:engine": "python -m uvicorn engine.server:app --app-dir src/modules/amazon-crawler --host 127.0.0.1 --port 8765 --reload",
    "dev:coordinator": "python -m uvicorn engine.distributed.coordinator_server:app --app-dir src/modules/amazon-crawler --host 0.0.0.0 --port 8766 --reload",
    "dev:pipeline": "node --disable-warning=ExperimentalWarning --import tsx scripts/shopify-pipeline-worker.ts",
    "dev:agent": "python scripts/amazon-crawler-agent.py --project-root .",
    "dev:mock": "node --disable-warning=ExperimentalWarning ./node_modules/vite/bin/vite.js --configLoader runner --mode mock",
    "build": "tsc --noEmit -p tsconfig.json && node --disable-warning=ExperimentalWarning ./node_modules/vite/bin/vite.js build --configLoader runner",
    "build:mock": "tsc --noEmit -p tsconfig.json && node --disable-warning=ExperimentalWarning ./node_modules/vite/bin/vite.js build --configLoader runner --mode mock",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.gateway.json && tsc --noEmit -p tsconfig.pipeline.json",
    "typecheck:gateway": "tsc --noEmit -p tsconfig.gateway.json",
    "test": "npm run test:tooling && npm run test:web && npm run test:gateway && npm run test:engine && npm run test:review-image && npm run test:pinterest",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:web": "tsx --test src/config/__tests__/*.test.ts src/modules/*/__tests__/*.test.ts src/pages/**/__tests__/*.test.ts src/shared/**/__tests__/*.test.ts testing/module-seo-content/*.test.ts",
    "test:gateway": "tsx --test gateway/__tests__/*.test.ts",
    "test:engine": "python -m unittest discover -s src/modules/amazon-crawler/engine/tests -t src/modules/amazon-crawler -p \"test_*.py\"",
    "test:review-image": "python -m pytest -q src/modules/review-image/server/tests && node browser-extension/review-image/test-content.cjs && node browser-extension/review-image/test-background.cjs",
    "test:pinterest": "python -m unittest discover -s src/modules/pinterest-pod/server/tests -p \"test_*.py\"",
    "test:distributed": "python -m unittest discover -s src/modules/amazon-crawler/engine/tests -t src/modules/amazon-crawler -p \"test_distributed.py\" -v --locals",
    "gateway:start": "node --disable-warning=ExperimentalWarning --import tsx gateway/server.ts",
    "server:pod": "python src/modules/pinterest-pod/server/server.py --reload",
    "build:agent": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-amazon-crawler-client.ps1 -SkipInstaller",
    "build:agent:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-amazon-crawler-client.ps1",
    "preview": "node --disable-warning=ExperimentalWarning ./node_modules/vite/bin/vite.js preview --configLoader runner"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.0",
    "playwright": "^1.58.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.20.0",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  }
}
