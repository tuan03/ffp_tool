# AI
AI_PROVIDER=gemini_vertex
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_ANALYSIS_MODEL=gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-pro
IMAGEN_MODEL=imagen-3.0-generate-002
AI_MAX_OUTPUT_TOKENS=8192

# Shopify pricing rule shared by Amazon and Etsy
SHOPIFY_PRICE_SHIPPING_ADD=6.95

# Amazon
AMAZON_US_PROFILE=1
AMAZON_US_ZIP=10001
AMAZON_US_SESSION_RETRY_COOLDOWN_SECONDS=900
AMAZON_US_SESSION_BOOTSTRAP_TIMEOUT_SECONDS=12
MAX_VARIANTS=100
MAX_AMAZON_MATRIX_VARIANTS=500
VARIANT_CONCURRENCY=5
VARIANT_DELAY_MS=450
VARIANT_MATRIX_FAST_SWEEP=1
VARIANT_MATRIX_FORCE_SWEEP=0
AMAZON_PARENT_DEFER_TO_MATRIX_SWEEP=1
VARIANT_MATRIX_WAIT_MS=700
VARIANT_MATRIX_TIMEOUT_SECONDS=600
PLAYWRIGHT_MATRIX_NAV_TIMEOUT_MS=30000
VARIANT_FAMILY_MEDIA_CONCURRENCY=5
VARIANT_DISTRIBUTE_PLAYWRIGHT_PROFILES=1
VARIANT_FAMILY_FETCH_TIMEOUT_SECONDS=35
VARIANT_OFFER_FALLBACK_RETRIES=0
VARIANT_OFFER_TIMEOUT_SECONDS=20
VARIANT_OFFER_PLAYWRIGHT_FALLBACK=1
VARIANT_FAMILY_OFFER_WAIT_MS=700
VARIANT_FAMILY_PLAYWRIGHT_PROBE=0
VARIANT_PLAYWRIGHT_FALLBACK=1
VARIANT_MIN_GALLERY_IMAGES=1
VARIANT_URL_FALLBACK_RETRIES=2
VARIANT_URL_FALLBACK_DELAY_MS=1800
VARIANT_EXACT_REFETCH_RETRIES=0
VARIANT_EXACT_REFETCH_TIMEOUT_SECONDS=20
CRAWL_INCLUDE_VIDEOS=0

# Browser pools
PLAYWRIGHT_HEADLESS=0
PLAYWRIGHT_WAIT_SIGNIN=1
PLAYWRIGHT_CAPTCHA_TIMEOUT_SECONDS=180
PLAYWRIGHT_AMAZON_ZIP_TIMEOUT_MS=15000
PLAYWRIGHT_PROFILES=2
PLAYWRIGHT_TABS_PER_PROFILE=3
PLAYWRIGHT_PREWARM=1
PLAYWRIGHT_FAST_DOCUMENT=1
PLAYWRIGHT_FAST_DOCUMENT_BODY_TIMEOUT_SECONDS=12
PLAYWRIGHT_PRODUCT_NAV_TIMEOUT_MS=30000
PLAYWRIGHT_PRODUCT_DOM_TIMEOUT_MS=15000

# Etsy Open API and OAuth. Never commit real credentials.
ETSY_API_KEYSTRING=your-etsy-keystring
ETSY_SHARED_SECRET=your-etsy-shared-secret
ETSY_ACCESS_TOKEN=your-etsy-access-token
ETSY_REFRESH_TOKEN=your-etsy-refresh-token
# Managed automatically after OAuth/refresh; leave blank initially if unknown.
ETSY_ACCESS_TOKEN_EXPIRES_AT=
ETSY_PLAYWRIGHT_USER_DATA_DIR=.etsy-playwright-profile
ETSY_VERIFY_DISPLAYED_PRICES=1
ETSY_VARIATION_WAIT_MS=650

# Crawler concurrency
PRODUCT_THREADS=5
URLLIB_THREADS=8
IMAGE_PROCESSING_THREADS=5
IMAGE_ASSET_CONCURRENCY=5

# Crawler UI and cache
UI_PORT=8765
NO_OPEN_BROWSER=0
PRODUCT_CACHE_FILE=data/data_cache.bin

# Personalization/customizer service
CUSTOMIZE_SYNC_DOMAIN=https://your-ngrok-or-public-domain.example
CUSTOMIZE_SYNC_PATH=/api/shopify/sync-api
CUSTOMIZE_SYNC_MAX_ATTEMPTS=4
CUSTOMIZE_SYNC_RETRY_BASE_SECONDS=2
CUSTOMIZER_ADMIN_SECRET=replace-with-a-long-random-secret

# Optional Amazon Reviews login. Prefer a dedicated account.
AMAZON_LOGIN_EMAIL=
AMAZON_LOGIN_PASSWORD=
AMAZON_REVIEW_USER_DATA_DIR=.amazon-playwright-review-profile
AMAZON_REVIEW_MAX_PAGES=50

# Debug (normally disabled)
CRAWL_IMAGE_DEBUG=0
CRAWL_FETCH_DEBUG=0
CRAWL_PRICE_DEBUG=0
CRAWL_CUSTOMIZATION_DEBUG=0
