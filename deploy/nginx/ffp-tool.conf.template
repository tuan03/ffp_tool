# Nginx configuration template for FFP Tool (3-container topology: client, server, database)
# Role: Client container Nginx serving React SPA and reverse proxying APIs to server container

upstream gateway_backend {
    server {{GATEWAY_HOST:-server}}:3001;
    keepalive 32;
}

upstream coordinator_backend {
    server {{COORDINATOR_HOST:-server}}:8766;
    keepalive 32;
}

upstream pinterest_backend {
    server {{PINTEREST_HOST:-server}}:8768;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN:-localhost}};

    client_max_body_size 50M;

    # Gzip Compression for static assets
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # -------------------------------------------------------------
    # 1. Gateway API Routes -> server:3001
    # -------------------------------------------------------------
    location ~ ^/(api/shopify|api/stores|api/auto-seo|api/proxy|api/seo-review) {
        proxy_pass http://gateway_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass_request_headers on;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Custom GPT SEO admin & actions -> Gateway server:3001
    location ~ ^/api/v1/gpt-seo {
        proxy_pass http://gateway_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass_request_headers on;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Pinterest POD specific handover routes -> Gateway server:3001
    location ~ ^/api/pinterest-pod/(handover-seo|sync-shopify) {
        proxy_pass http://gateway_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass_request_headers on;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # -------------------------------------------------------------
    # 2. Crawler Coordinator Routes -> server:8766
    # -------------------------------------------------------------
    # Handles crawl-jobs, clients, worker WebSocket, product reviews, image profiles
    location ~ ^/api/v1/ {
        proxy_pass http://coordinator_backend;
        proxy_http_version 1.1;

        # WebSocket support for /api/v1/worker/connect
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass_request_headers on;

        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # -------------------------------------------------------------
    # 3. Pinterest POD Routes -> server:8768
    # -------------------------------------------------------------
    location ~ ^/api/pinterest-pod/ {
        proxy_pass http://pinterest_backend;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass_request_headers on;

        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # -------------------------------------------------------------
    # 4. Unknown API Routes (UI-08: API 404 returns JSON, never HTML)
    # -------------------------------------------------------------
    location ~ ^/api/ {
        default_type application/json;
        return 404 '{"error":"Not Found","message":"API endpoint not found","statusCode":404}\n';
    }

    # -------------------------------------------------------------
    # 5. React SPA Frontend (Client UI)
    # -------------------------------------------------------------
    # Serves pre-built Vite assets from static root.
    # Non-existent UI routes fallback to index.html -> React Router NotFoundPage
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;

        location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2)$ {
            expires 1y;
            access_log off;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
    }
}
