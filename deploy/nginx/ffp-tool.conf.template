# Nginx configuration template for FFP Tool
# Handles SPA, Gateway APIs, Custom GPT SEO Actions, and WebSockets

server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    client_max_body_size 30M;

    location / {
        proxy_pass http://127.0.0.1:{{APP_PORT}};
        proxy_http_version 1.1;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Keep authorization headers for Custom GPT Bearer tokens & Gateway keys
        proxy_pass_request_headers on;

        # Timeouts compatible with OpenAI Actions (45s max)
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
