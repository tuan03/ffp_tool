            "actionKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Public product image URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "imageId",
                    "imageUrl",
                    "instructions"
                  ],
                  "properties": {
                    "imageId": {
                      "type": "string",
                      "description": "Stable image identifier. Do not open this value as a URL."
                    },
                    "imageUrl": {
                      "type": "string",
                      "format": "uri",
                      "description": "FFP-hosted public HTTPS image URL to open and inspect without authentication."
                    },
                    "instructions": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid jobId, imageId or non-public image URL"
          },
          "401": {
            "description": "Invalid API key"
          },
          "404": {
            "description": "Job or image not found"
          },
          "429": {
            "description": "Image download busy; respect Retry-After"
          }
        },
