# FFP Tool production environment template.
# Copy this file to .env, fill every required blank, and keep .env private.

NODE_ENV=production

# --- Public client endpoint ---
# Keep 127.0.0.1 when a host-level HTTPS reverse proxy fronts FFP on a VPS.
# Use 0.0.0.0 only when the client must be reachable directly, for example on a trusted LAN.
CLIENT_BIND_ADDRESS=127.0.0.1
CLIENT_PORT=3010
VITE_AGENT_INSTALL_URL=https://your-ffp-domain.example

# --- Unified PostgreSQL database ---
POSTGRES_DB=ffp_tool
POSTGRES_USER=ffp_tool
# Required: generate a long random value before starting Compose.
POSTGRES_PASSWORD=

# --- Runtime resource limits ---
DATABASE_CPUS=1.0
DATABASE_MEMORY_LIMIT=1g
DATABASE_PIDS_LIMIT=200
SERVER_CPUS=2.0
SERVER_MEMORY_LIMIT=3g
SERVER_PIDS_LIMIT=512
CLIENT_CPUS=0.5
CLIENT_MEMORY_LIMIT=256m
CLIENT_PIDS_LIMIT=100

# --- Per-container Docker log rotation ---
DATABASE_LOG_MAX_SIZE=10m
DATABASE_LOG_MAX_FILES=3
SERVER_LOG_MAX_SIZE=10m
SERVER_LOG_MAX_FILES=3
CLIENT_LOG_MAX_SIZE=10m
CLIENT_LOG_MAX_FILES=3

# --- Amazon crawler coordinator ---
AMAZON_COORDINATOR_CORS_ORIGINS=https://your-ffp-domain.example

# Local development: use .env.local with VITE_APP_ENV=development.
# Host-side PostgreSQL URLs use 127.0.0.1; Compose uses database.
# VITE_AMAZON_COORDINATOR_URL=http://127.0.0.1:8766
# VITE_AMAZON_CRAWLER_RELEASE_API_URL=https://api.github.com/repos/tuan03/ffp_tool/releases/latest
AMAZON_COORDINATOR_JOB_RETENTION_MINUTES=60
# AMAZON_CRAWLER_PROXIES=http://username:password@host:port,http://host2:port
# AMAZON_CRAWLER_PROXY_CONFIG=config/amazon-crawler-profiles.json

# --- Pinterest POD OAuth (server-side only) ---
# Register this exact HTTPS callback URL in the Pinterest Developer App.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=https://your-ffp-domain.example/api/pinterest-pod/oauth/callback
# Recommended: generate an independent random value.
PINTEREST_OAUTH_STATE_SECRET=
PINTEREST_SCOPES=user_accounts:read,boards:read,pins:read,ads:read

# --- Shopify Gateway ---
GATEWAY_STORE_ID=
GATEWAY_SHOP_DOMAIN=
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
# Required for authenticated Gateway routes; keep this server-side.
GATEWAY_AUTH_TOKEN=

# Optional browser login for the deployed FFP Tool UI. Configure both together.
FFP_OPERATOR_USERNAME=
FFP_OPERATOR_PASSWORD=

# --- Product streaming pipeline ---
# Gateway and Coordinator share the server container, so this stays internal.
SHOPIFY_PIPELINE_COORDINATOR_URL=http://127.0.0.1:8766
SHOPIFY_PIPELINE_WORKERS=8
SHOPIFY_PIPELINE_TOKEN=
SHOPIFY_PROXY_CONFIG=config/amazon-crawler-profiles.json
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3001
# Docker Review Studio shares the Coordinator process; use DISTINCT random values (24+ characters).
# Internal Gateway credential: never put it in the extension or VITE_ variables.
REVIEW_IMAGE_BRIDGE_TOKEN=
# Operator-controlled browser extension credential; enter only this one in its popup.
REVIEW_IMAGE_EXTENSION_TOKEN=
# Optional browser login for a deployed FFP Tool UI. Configure both values together.
# FFP_OPERATOR_USERNAME=admin
# FFP_OPERATOR_PASSWORD=replace-with-a-strong-unique-password
# Set the same private value for coordinator and pipeline worker in production.
# SHOPIFY_PIPELINE_TOKEN=

# Custom GPT SEO Actions (server-side only). Give every store a different random key.
# GPT_SEO_ACTION_KEYS_JSON={"capozen":"replace-with-random-key","wrydeco":"replace-with-another-random-key"}
# Codex MCP uses separate per-machine Bearer tokens. Never reuse Action or admin keys.
# One unique token per Codex machine. Legacy {"capozen":"token"} remains supported as worker "default".
# GPT_SEO_MCP_KEYS_JSON={"capozen":{"office-pc":"replace-with-random-mcp-key","laptop":"replace-with-another-random-mcp-key"}}
# Legacy single-store deployments may continue using GPT_SEO_ACTION_KEY plus GPT_SEO_STORE_ID.
# GPT_SEO_ACTION_KEY=
# GPT_SEO_STORE_ID=capozen
# GPT_SEO_PUBLIC_URL=https://seo.example.com
# Queue, Codex/Custom GPT reviews and Auto SEO share AUTO_SEO_DATABASE_URL / DATABASE_URL.
# Legacy path is only an offline migration/readiness guard, never runtime storage.
# GPT_SEO_DB_PATH=.local-data/custom-gpt-seo.sqlite3

# --- SEO pipeline ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_REQUEST_CONCURRENCY=4
SEO_SEARCH_PROVIDER=google
SEO_SEARCH_LANGUAGE=en
SEO_SEARCH_COUNTRY=us
SEO_EMBEDDING_PROVIDER=local
SEO_EMBEDDING_MODEL=text-embedding-004
SEO_EMBEDDING_CONCURRENCY=2
SEO_SUGGEST_CONCURRENCY=3
SEO_CONFLICT_CORPUS_PATH=/app/.runtime/seo-conflict-corpus.json

# --- Optional outbound proxy ---
GATEWAY_PROXY_URL=
GATEWAY_PROXY_USERNAME=
GATEWAY_PROXY_PASSWORD=

# Auto SEO backup and review runtime use PostgreSQL. Keep this server-only.
# Use a URL-encoded password if it contains special characters; use 127.0.0.1 for host-side tests.
# Production CI prepares this URL if absent. Explicit VPS values are preserved.
AUTO_SEO_DATABASE_URL=
# Legacy SQLite path is only for explicit read-only migration and tests.
AUTO_SEO_DB_PATH=.local-data/auto-seo.sqlite3
# Central Amazon product-image processing (runs after SEO and before Shopify).
IMAGE_PROCESSING_WORKERS=4
IMAGE_PROCESSING_CACHE_DIR=/app/.runtime/image-processing

# SEO Performance (optional; disabled until Google OAuth is configured)
SEO_PERFORMANCE_ENABLED=false
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=https://ffp.example.com/api/seo-performance/oauth/callback
# Generate 32 random bytes as 64 hexadecimal characters; keep only on server.
GSC_TOKEN_ENCRYPTION_KEY=
# Development Vite proxy to standalone Gateway (not the crawler coordinator).
SEO_PERFORMANCE_GATEWAY_URL=http://127.0.0.1:3001

# --- Ads Intelligence (Competitor Spy, Meta Insights, GA4, Shopify, AI Analyst) ---
# Primary & Secondary Competitor Spy API Keys (Facebook Ad Library scraping)
SCRAPE_CREATORS_API_KEY=
SEARCHAPI_API_KEY=
APIFY_TOKEN=

# Meta Marketing API v26.0 (System User Access Token & Proxy)
META_ACCESS_TOKEN=
META_PROXY_URL=
META_AD_ACCOUNT_ID=act_1010295448281555

# Google Analytics 4 (GA4 Data API)
GA4_PROPERTY_ID=555699138
GA4_CREDENTIALS_PATH=credentials/ga4-service-account.json

# Shopify Store Orders Access Token (per store or global)
SHOPIFY_ACCESS_TOKEN_CHILLGEN=

# AI Strategic Analyst Brain (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Guarded Writes Safety Policy (Keep false in V1/V2 for read-only safety)
FFP_ADS_EXTERNAL_WRITES_ENABLED=false
FFP_ADS_EMERGENCY_KILL_SWITCH=false

